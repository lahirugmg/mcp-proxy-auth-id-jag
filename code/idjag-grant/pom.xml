<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>identity-oauth-token-exchange-idjag</groupId>
    <artifactId>org.wso2.custom.identity.oauth2.grant.tokenexchange.idjag</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>bundle</packaging>

    <name>WSO2 IS - ID-JAG Token Exchange Grant</name>
    <description>
        Issues Identity Assertion JWT Authorization Grants (ID-JAG,
        draft-ietf-oauth-identity-assertion-authz-grant) from WSO2 Identity Server 7.3.0, with the ID-JAG "sub" claim
        set to the user's email address instead of the default subject UUID.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            Compiled against the OSGi bundles shipped with the target WSO2 IS distribution. This guarantees the
            extension is built against exactly the API the server runs, and needs no access to the WSO2 Maven
            repositories. scripts/install.sh passes -Dis.home and the exact jar versions found in your pack;
            the defaults below are those of the pack this was tested with.
        -->
        <is.home>${project.basedir}/../../setup/wso2is-7.3.0</is.home>
        <is.plugins>${is.home}/repository/components/plugins</is.plugins>

        <identity.oauth.version>7.4.99.34</identity.oauth.version>
        <identity.oauth.common.version>7.4.99.26</identity.oauth.common.version>
        <token.exchange.version>1.4.3</token.exchange.version>
        <identity.framework.version>7.10.156</identity.framework.version>
        <identity.framework.auth.version>7.10.156.48</identity.framework.auth.version>
        <identity.framework.core.version>7.10.156.19</identity.framework.core.version>
        <identity.framework.base.version>7.10.156.2</identity.framework.base.version>
        <carbon.user.core.version>4.12.34.7</carbon.user.core.version>
        <carbon.user.api.version>4.12.34</carbon.user.api.version>
        <carbon.utils.version>4.12.34.7</carbon.utils.version>
        <nimbusds.version>10.3.0.wso2v1</nimbusds.version>
        <commons.lang.version>2.6.0.wso2v1</commons.lang.version>

        <maven.bundle.plugin.version>5.1.9</maven.bundle.plugin.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>

        <!-- OSGi import ranges, kept deliberately wide so the bundle survives WSO2 update-level bumps. -->
        <carbon.identity.oauth.import.range>[6.0.0, 8.0.0)</carbon.identity.oauth.import.range>
        <carbon.identity.import.range>[5.0.0, 8.0.0)</carbon.identity.import.range>
        <carbon.kernel.import.range>[4.9.0, 5.0.0)</carbon.kernel.import.range>
        <carbon.user.api.import.range>[1.0.1, 2.0.0)</carbon.user.api.import.range>
        <token.exchange.import.range>[1.4.0, 2.0.0)</token.exchange.import.range>
        <nimbusds.import.range>[10.3.0, 11.0.0)</nimbusds.import.range>
        <commons.lang.import.range>[2.6.0, 3.0.0)</commons.lang.import.range>
        <commons.logging.import.range>[1.2, 2.0)</commons.logging.import.range>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.wso2.carbon.identity.inbound.auth.oauth2</groupId>
            <artifactId>org.wso2.carbon.identity.oauth</artifactId>
            <version>${identity.oauth.version}</version>
            <scope>system</scope>
            <systemPath>${is.plugins}/org.wso2.carbon.identity.oauth_${identity.oauth.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.inbound.auth.oauth2</groupId>
            <artifactId>org.wso2.carbon.identity.oauth.common</artifactId>
            <version>${identity.oauth.common.version}</version>
            <scope>system</scope>
            <systemPath>
                ${is.plugins}/org.wso2.carbon.identity.oauth.common_${identity.oauth.common.version}.jar
            </systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.extension.identity.oauth2.grantType.token.exchange</groupId>
            <artifactId>org.wso2.carbon.identity.oauth2.grant.token.exchange</artifactId>
            <version>${token.exchange.version}</version>
            <scope>system</scope>
            <systemPath>
                ${is.plugins}/org.wso2.carbon.identity.oauth2.grant.token.exchange_${token.exchange.version}.jar
            </systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.authentication.framework</artifactId>
            <version>${identity.framework.auth.version}</version>
            <scope>system</scope>
            <systemPath>
                ${is.plugins}/org.wso2.carbon.identity.application.authentication.framework_${identity.framework.auth.version}.jar
            </systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.common</artifactId>
            <version>${identity.framework.version}</version>
            <scope>system</scope>
            <systemPath>
                ${is.plugins}/org.wso2.carbon.identity.application.common_${identity.framework.version}.jar
            </systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.core</artifactId>
            <version>${identity.framework.core.version}</version>
            <scope>system</scope>
            <systemPath>
                ${is.plugins}/org.wso2.carbon.identity.core_${identity.framework.core.version}.jar
            </systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.base</artifactId>
            <version>${identity.framework.base.version}</version>
            <scope>system</scope>
            <systemPath>
                ${is.plugins}/org.wso2.carbon.identity.base_${identity.framework.base.version}.jar
            </systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.user.core</artifactId>
            <version>${carbon.user.core.version}</version>
            <scope>system</scope>
            <systemPath>${is.plugins}/org.wso2.carbon.user.core_${carbon.user.core.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.user.api</artifactId>
            <version>${carbon.user.api.version}</version>
            <scope>system</scope>
            <systemPath>${is.plugins}/org.wso2.carbon.user.api_${carbon.user.api.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.utils</artifactId>
            <version>${carbon.utils.version}</version>
            <scope>system</scope>
            <systemPath>${is.plugins}/org.wso2.carbon.utils_${carbon.utils.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.wso2.orbit.com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbusds.version}</version>
            <scope>system</scope>
            <systemPath>${is.plugins}/nimbus-jose-jwt_${nimbusds.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>commons-lang.wso2</groupId>
            <artifactId>commons-lang</artifactId>
            <version>${commons.lang.version}</version>
            <scope>system</scope>
            <systemPath>${is.plugins}/commons-lang_${commons.lang.version}.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
            <scope>system</scope>
            <systemPath>${is.home}/lib/commons-logging-1.2.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.target}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven.bundle.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.artifactId}</Bundle-Name>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Export-Package>
                            org.wso2.custom.identity.oauth2.grant.idjag;version="${project.version}"
                        </Export-Package>
                        <Import-Package>
                            com.nimbusds.jose;version="${nimbusds.import.range}",
                            com.nimbusds.jose.crypto;version="${nimbusds.import.range}",
                            com.nimbusds.jwt;version="${nimbusds.import.range}",
                            org.apache.commons.lang;version="${commons.lang.import.range}",
                            org.apache.commons.logging;version="${commons.logging.import.range}",
                            org.wso2.carbon.identity.application.authentication.framework.exception;version="${carbon.identity.import.range}",
                            org.wso2.carbon.identity.application.authentication.framework.model;version="${carbon.identity.import.range}",
                            org.wso2.carbon.identity.application.common.model;version="${carbon.identity.import.range}",
                            org.wso2.carbon.identity.core.util;version="${carbon.identity.import.range}",
                            org.wso2.carbon.identity.base;version="${carbon.identity.import.range}",
                            org.wso2.carbon.identity.oauth.common;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth.config;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth.tokenprocessor;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2.dto;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2.internal;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2.model;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2.token;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2.token.handlers.grant;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2.util;version="${carbon.identity.oauth.import.range}",
                            org.wso2.carbon.identity.oauth2.grant.token.exchange;version="${token.exchange.import.range}",
                            org.wso2.carbon.identity.oauth2.grant.token.exchange.utils;version="${token.exchange.import.range}",
                            org.wso2.carbon.user.api;version="${carbon.user.api.import.range}",
                            org.wso2.carbon.user.core;version="${carbon.kernel.import.range}",
                            org.wso2.carbon.user.core.common;version="${carbon.kernel.import.range}",
                            org.wso2.carbon.utils.multitenancy;version="${carbon.kernel.import.range}"
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
