<class name="org.wso2.mcpgov.idjag.IdJagTokenMediator">
    <property name="idpTokenEndpoint" value="{{idpTokenEndpoint}}"/>
    <property name="idpClientId" value="{{idpClientId}}"/>
    <property name="idpClientSecret" value="{{idpClientSecret}}"/>
    <property name="audience" value="{{audience}}"/>
    <property name="idpScopes" value="{{idpScopes}}"/>
    <property name="resourceAsTokenEndpoint" value="{{resourceAsTokenEndpoint}}"/>
    <property name="resourceAsClientId" value="{{resourceAsClientId}}"/>
    <property name="resourceAsClientSecret" value="{{resourceAsClientSecret}}"/>
    <property name="resourceAsScopes" value="{{resourceAsScopes}}"/>
    <property name="idTokenHeader" value="{{idTokenHeader}}"/>
    <property name="timeoutMillis" value="{{timeoutMillis}}"/>
    <property name="tlsInsecureSkipVerify" value="{{tlsInsecureSkipVerify}}"/>
    <property name="authorizationServer" value="{{authorizationServer}}"/>
    <property name="scopesSupported" value="{{scopesSupported}}"/>
</class>
