                  "pm.test('dana has grants', () => pm.expect(mine.length).to.be.above(0));",
                  "pm.test('all via id-jag, for the gateway client, without refresh tokens', () => mine.forEach(x => {",
                  "    pm.expect(x.via).to.eql('id-jag');",
                  "    pm.expect(x.clientId).to.eql(pm.variables.get('gateway_client_id'));",
                  "    pm.expect(x.liveRefreshTokens).to.eql(0);",
                  "}));"
                ]
              }
            }
          ]
        },
